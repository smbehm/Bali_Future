# ─── Client (Vite — prefix VITE_; set in Vercel → Environment Variables) ───
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── Server (Vercel serverless — api/send-email.ts, NOT exposed to browser) ───
RESEND_API_KEY=re_xxxxxxxx
INTAKE_EMAIL_TO=team@yourdomain.com
# Optional; must be a verified sender/domain in Resend
RESEND_FROM_EMAIL=Bali Future <onboarding@resend.dev>
