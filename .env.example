# ─── Client (Vite — prefix VITE_; set in Vercel → Environment Variables) ───
# IMPORTANT: These must be available during the Vercel *build* (not runtime-only).
# Scope: Production + Preview. After changing, trigger a new deployment.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── Server (Vercel serverless — api/send-email.ts, NOT exposed to browser) ───
# Set in Vercel → Environment Variables (Production + Preview). Redeploy after changes.
RESEND_API_KEY=re_xxxxxxxx
INTAKE_EMAIL_TO=team@yourdomain.com
# Optional; must be a verified sender/domain in Resend
RESEND_FROM_EMAIL=Bali Future <onboarding@resend.dev>

# ─── Local dev only (vite.config.ts middleware mirrors api/send-email.ts) ───
# Copy to .env.local: VITE_* + RESEND_* + INTAKE_EMAIL_TO for form + email testing.
