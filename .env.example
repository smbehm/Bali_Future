# Copy to .env locally. On Vercel, add these in Project → Settings → Environment Variables.
# Never prefix secret keys with VITE_ (they would be exposed in the browser bundle).

# Supabase (public anon key is OK in Vite; still use env vars, not hardcoding)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Resend — server-only; used by /api/send-email (Vite dev middleware + Vercel serverless)
RESEND_API_KEY=
